{
  "name": "serversentry-custom-storefront",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run check && vite build && node scripts/package.mjs",
    "preview": "vite preview",
    "format": "prettier --write src tests scripts *.json *.ts *.html *.md docs/*.md"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.1.5"
  }
}
